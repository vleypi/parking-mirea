<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.project.fx.VehicleController"
      styleClass="entity-view" spacing="12">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <Label text="Автомобили" styleClass="view-title"/>
    <HBox styleClass="toolbar">
        <Button text="Добавить" onAction="#create" styleClass="button-primary"/>
        <Button fx:id="editButton" text="Изменить" onAction="#edit"/>
        <Button fx:id="deleteButton" text="Удалить" onAction="#delete" styleClass="button-danger"/>
        <Button text="Обновить" onAction="#refresh"/>
        <Button text="Стояли в период" onAction="#showParkedDuring"/>
        <Button fx:id="statisticsButton" text="Статистика" onAction="#showStatistics"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="form-label"/>
    </HBox>
    <VBox spacing="8">
        <FlowPane hgap="10" vgap="8" alignment="CENTER_LEFT">
            <Label text="Гос. номер" styleClass="form-label"/>
            <TextField fx:id="plateSearchField" promptText="часть номера" prefWidth="130" onAction="#applyFilters"/>
            <Label text="Модель" styleClass="form-label"/>
            <TextField fx:id="modelSearchField" promptText="часть названия" prefWidth="140" onAction="#applyFilters"/>
            <Label text="Регион" styleClass="form-label"/>
            <TextField fx:id="regionField" promptText="777" prefWidth="70" onAction="#applyFilters"/>
            <Label text="Марка" styleClass="form-label"/>
            <ComboBox fx:id="brandFilterBox" prefWidth="150"/>
            <Label text="Владелец" styleClass="form-label"/>
            <ComboBox fx:id="ownerFilterBox" prefWidth="200"/>
        </FlowPane>
        <FlowPane hgap="10" vgap="8" alignment="CENTER_LEFT">
            <Button text="Применить" onAction="#applyFilters"/>
            <Button text="Сбросить фильтры" onAction="#resetFilters"/>
            <Label text="Сортировать по" styleClass="form-label"/>
            <ComboBox fx:id="sortFieldBox" prefWidth="170"/>
            <CheckBox fx:id="descendingCheckBox" text="по убыванию"/>
        </FlowPane>
        <Label fx:id="filterErrorLabel" styleClass="error-label" wrapText="true"/>
    </VBox>
    <TableView fx:id="vehicleTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder>
            <Label fx:id="placeholderLabel" text="Автомобилей нет" styleClass="placeholder"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="plateColumn" text="Гос. номер"/>
            <TableColumn fx:id="regionColumn" text="Регион"/>
            <TableColumn fx:id="brandColumn" text="Марка"/>
            <TableColumn fx:id="modelColumn" text="Модель"/>
            <TableColumn fx:id="ownerColumn" text="Владелец"/>
        </columns>
    </TableView>
    <Label text="Заявки выбранного автомобиля" styleClass="form-label"/>
    <TableView fx:id="requestTable" prefHeight="170" minHeight="120">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder>
            <Label fx:id="requestPlaceholderLabel" text="Выберите автомобиль в таблице выше" styleClass="placeholder"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="requestSpotColumn" text="Место"/>
            <TableColumn fx:id="requestStartColumn" text="Начало"/>
            <TableColumn fx:id="requestEndColumn" text="Окончание"/>
            <TableColumn fx:id="requestStatusColumn" text="Статус"/>
        </columns>
    </TableView>
</VBox>