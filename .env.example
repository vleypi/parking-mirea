# Образец настроек для backend/docker-compose.yml.
# Скопируйте в .env (или запустите .\backend\init-env.ps1 — он сгенерирует пароли и секрет).
# Файл .env в репозиторий не коммитится.

POSTGRES_DB=parking_db
POSTGRES_USER=parking_app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55432

# Base64 от случайных 64 байт: [Convert]::ToBase64String((1..64 | % { Get-Random -Max 256 }))
JWT_SECRET_BASE64=change-me
JWT_ISSUER=parking
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Первый администратор создаётся, пока в базе нет учётных записей. Пароль временный: после входа его нужно сменить.
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_NAME=Администратор
BOOTSTRAP_ADMIN_PASSWORD=change-me

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
COOKIE_SECURE=false
PERMANENT_DELETE_ENABLED=false
APP_PORT=8080
