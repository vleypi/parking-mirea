<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.project.fx.RequestController"
      styleClass="entity-view" spacing="12">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <Label text="Заявки на парковку" styleClass="view-title"/>
    <HBox styleClass="toolbar">
        <Button text="Обновить" onAction="#refresh"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="form-label"/>
    </HBox>
    <TableView fx:id="requestTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="Заявок нет" styleClass="placeholder"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="ownerColumn" text="Владелец"/>
            <TableColumn fx:id="vehicleColumn" text="Автомобиль"/>
            <TableColumn fx:id="spotColumn" text="Место"/>
            <TableColumn fx:id="startColumn" text="Начало"/>
            <TableColumn fx:id="endColumn" text="Окончание"/>
            <TableColumn fx:id="statusColumn" text="Статус"/>
        </columns>
    </TableView>
</VBox>
