<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.project.fx.SpotController"
      styleClass="entity-view" spacing="12">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <Label text="Парковочные места" styleClass="view-title"/>
    <HBox styleClass="toolbar">
        <Button text="Добавить" onAction="#create" styleClass="button-primary"/>
        <Button fx:id="editButton" text="Изменить" onAction="#edit"/>
        <Button fx:id="deleteButton" text="Удалить" onAction="#delete"/>
        <Button text="Обновить" onAction="#refresh"/>
        <Button text="Свободные на период" onAction="#showFreeSpots"/>
        <Button fx:id="statisticsButton" text="Статистика" onAction="#showStatistics"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="form-label"/>
    </HBox>
    <VBox spacing="8">
        <TextField fx:id="searchField" promptText="Поиск по номеру места или типу"/>
        <FlowPane hgap="10" vgap="8" alignment="CENTER_LEFT">
            <Label text="Тип" styleClass="form-label"/>
            <ComboBox fx:id="typeFilterBox" prefWidth="200"/>
            <Label text="Номер" styleClass="form-label"/>
            <TextField fx:id="numberFromField" promptText="от" prefWidth="70" onAction="#applyFilters"/>
            <TextField fx:id="numberToField" promptText="до" prefWidth="70" onAction="#applyFilters"/>
            <Label text="Тариф, руб/ч" styleClass="form-label"/>
            <TextField fx:id="rateFromField" promptText="от" prefWidth="80" onAction="#applyFilters"/>
            <TextField fx:id="rateToField" promptText="до" prefWidth="80" onAction="#applyFilters"/>
            <Button text="Применить" onAction="#applyFilters"/>
            <Button text="Сбросить фильтры" onAction="#resetFilters"/>
        </FlowPane>
        <FlowPane hgap="10" vgap="8" alignment="CENTER_LEFT">
            <Label text="Сортировать по" styleClass="form-label"/>
            <ComboBox fx:id="sortFieldBox" prefWidth="170"/>
            <CheckBox fx:id="descendingCheckBox" text="по убыванию"/>
        </FlowPane>
        <Label fx:id="filterErrorLabel" styleClass="error-label" wrapText="true"/>
    </VBox>
    <SplitPane orientation="VERTICAL" dividerPositions="0.6" VBox.vgrow="ALWAYS">
        <TableView fx:id="spotTable">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label fx:id="placeholderLabel" text="Парковочных мест нет" styleClass="placeholder"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="numberColumn" text="Номер места"/>
                <TableColumn fx:id="typeColumn" text="Тип"/>
                <TableColumn fx:id="rateColumn" text="Тариф, руб/ч"/>
            </columns>
        </TableView>
        <VBox spacing="6">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="relatedTitleLabel" styleClass="details-section"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="occupancyLabel"/>
            </HBox>
            <TableView fx:id="relatedTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label fx:id="relatedPlaceholderLabel" styleClass="placeholder"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="relatedOwnerColumn" text="Владелец"/>
                    <TableColumn fx:id="relatedPlateColumn" text="Автомобиль"/>
                    <TableColumn fx:id="relatedStartColumn" text="Начало"/>
                    <TableColumn fx:id="relatedEndColumn" text="Окончание"/>
                    <TableColumn fx:id="relatedStatusColumn" text="Статус"/>
                </columns>
            </TableView>
        </VBox>
    </SplitPane>
</VBox>
