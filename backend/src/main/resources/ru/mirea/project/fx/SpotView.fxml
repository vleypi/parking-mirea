<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.project.fx.SpotController"
      styleClass="entity-view" spacing="12">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <Label text="Парковочные места" styleClass="view-title"/>
    <HBox styleClass="toolbar">
        <Button text="Добавить" onAction="#create" styleClass="button-primary"/>
        <Button fx:id="editButton" text="Изменить" onAction="#edit"/>
        <Button text="Обновить" onAction="#refresh"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="form-label"/>
    </HBox>
    <TableView fx:id="spotTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="Парковочных мест нет" styleClass="placeholder"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="numberColumn" text="Номер места"/>
            <TableColumn fx:id="typeColumn" text="Тип"/>
            <TableColumn fx:id="rateColumn" text="Тариф, руб/ч"/>
        </columns>
    </TableView>
</VBox>
