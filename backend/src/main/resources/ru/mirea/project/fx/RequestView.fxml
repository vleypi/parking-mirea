<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.project.fx.RequestController"
      styleClass="entity-view" spacing="12">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
    <Label text="Заявки на парковку" styleClass="view-title"/>
    <HBox styleClass="toolbar">
        <Button text="Добавить" onAction="#create" styleClass="button-primary"/>
        <Button fx:id="editButton" text="Изменить" onAction="#edit"/>
        <Button fx:id="deleteButton" text="Удалить" onAction="#delete" styleClass="button-danger"/>
        <Button text="Обновить" onAction="#refresh"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="form-label"/>
    </HBox>
    <VBox spacing="8">
        <FlowPane hgap="10" vgap="8" alignment="CENTER_LEFT">
            <Label text="Владелец" styleClass="form-label"/>
            <TextField fx:id="ownerSearchField" promptText="часть имени" prefWidth="160" onAction="#applyFilters"/>
            <Label text="Гос. номер" styleClass="form-label"/>
            <TextField fx:id="plateSearchField" promptText="часть номера" prefWidth="130" onAction="#applyFilters"/>
            <Label text="Статус" styleClass="form-label"/>
            <ComboBox fx:id="statusFilterBox" prefWidth="150"/>
            <Label text="Тип места" styleClass="form-label"/>
            <ComboBox fx:id="spotTypeFilterBox" prefWidth="220"/>
        </FlowPane>
        <FlowPane hgap="10" vgap="8" alignment="CENTER_LEFT">
            <Label text="Место №" styleClass="form-label"/>
            <TextField fx:id="spotNumberField" prefWidth="60" onAction="#applyFilters"/>
            <Label text="Период с" styleClass="form-label"/>
            <DatePicker fx:id="periodFromPicker" editable="false" prefWidth="140"/>
            <Label text="по" styleClass="form-label"/>
            <DatePicker fx:id="periodToPicker" editable="false" prefWidth="140"/>
            <Button text="Применить" onAction="#applyFilters"/>
            <Button text="Сбросить фильтры" onAction="#resetFilters"/>
        </FlowPane>
        <Label fx:id="filterErrorLabel" styleClass="error-label" wrapText="true"/>
    </VBox>
    <TableView fx:id="requestTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <placeholder>
            <Label fx:id="placeholderLabel" text="Заявок нет" styleClass="placeholder"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="ownerColumn" text="Владелец"/>
            <TableColumn fx:id="vehicleColumn" text="Автомобиль"/>
            <TableColumn fx:id="spotColumn" text="Место"/>
            <TableColumn fx:id="startColumn" text="Начало"/>
            <TableColumn fx:id="endColumn" text="Окончание"/>
            <TableColumn fx:id="statusColumn" text="Статус"/>
        </columns>
    </TableView>
</VBox>
