<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonType?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<DialogPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.project.fx.SpotFreeController" prefWidth="560">
    <buttonTypes>
        <ButtonType text="Закрыть" buttonData="CANCEL_CLOSE"/>
    </buttonTypes>
    <content>
        <VBox spacing="12">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Период с" styleClass="form-label"/>
                <DatePicker fx:id="fromPicker" editable="false" prefWidth="140"/>
                <Label text="по" styleClass="form-label"/>
                <DatePicker fx:id="toPicker" editable="false" prefWidth="140"/>
                <Button text="Найти" onAction="#search" styleClass="button-primary"/>
            </HBox>
            <Label text="Укажите обе даты. Место занято, если на него есть заявка «Новая» или «Подтверждена» в этом периоде"
                   styleClass="form-label" wrapText="true"/>
            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
            <TableView fx:id="freeTable" prefHeight="260">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label fx:id="placeholderLabel" text="Укажите период и нажмите «Найти»" styleClass="placeholder"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="numberColumn" text="Номер места"/>
                    <TableColumn fx:id="typeColumn" text="Тип"/>
                    <TableColumn fx:id="rateColumn" text="Тариф, руб/ч"/>
                </columns>
            </TableView>
            <Label fx:id="resultLabel" styleClass="form-label"/>
        </VBox>
    </content>
</DialogPane>
